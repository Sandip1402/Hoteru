generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId               Int           @id @default(autoincrement())
  auth0Id              String        @unique
  image                String?
  firstname            String?
  lastname             String?
  DOB                  DateTime?
  isAdult              Boolean?
  email                String        @unique(map: "idx_users_email_unique")
  country              String?
  createdAt            DateTime?     @default(now())
  updatedAt            DateTime?     @updatedAt
  bookings             Booking[]
  HostRequests         HostRequest[]
  verifiedHostRequests HostRequest[] @relation("HostRequestVerifier")
  wishList             Wishlist[]
  approvedListings     Listing[]     @relation("ListingApprover")
  ownedListings        Listing[]     @relation("ListingOwner")
  reviews              Review[]

  @@index([country], map: "idx_users_country")
  @@index([createdAt], map: "idx_users_created_at")
}

model Booking {
  bookingId          Int            @id @default(autoincrement())
  bookingReference   String         @unique
  roomId             Int
  roomName           String
  listingName        String
  listingId          Int
  thumbnailUrl       String
  guestId            Int
  guests             Int
  checkIn            DateTime
  checkOut           DateTime
  pricePerNight      Decimal        @db.Decimal(10, 2)
  bookingAmount      Decimal        @db.Decimal(10, 2)
  remainingAmount    Decimal        @db.Decimal(10, 2)
  paidAmount         Decimal        @db.Decimal(10, 2)
  totalPrice         Decimal        @db.Decimal(10, 2)
  status             BookingStatus  @default(AWAITING_PAYMENT)
  cancellationReason String?
  cancelledAt        DateTime?
  completedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  paymentOption      PaymentOption
  paymentStatus      BookingPayment @default(PENDING)
  guest              User           @relation(fields: [guestId], references: [userId])
  listing            Listing        @relation(fields: [listingId], references: [listingId])
  room               Room           @relation(fields: [roomId], references: [roomId])
  payments           Payment[]
  review             Review?

  @@index([roomId, status])
  @@index([guestId])
  @@index([status])
  @@index([checkIn])
}

model Payment {
  paymentId        Int             @id @default(autoincrement())
  bookingId        Int
  amount           Decimal         @db.Decimal(10, 2)
  purpose          PaymentPurpose
  mode             PaymentMode
  status           PaymentStatus   @default(PENDING)
  
  gateway          PaymentGateway?
  gatewayOrderId   String?
  gatewayPaymentId String?
  gatewaySignature String?
  gatewayMethod    String?

  paidAt           DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  booking          Booking         @relation(fields: [bookingId], references: [bookingId], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
}

model Room {
  roomId      Int           @id @default(autoincrement())
  listingId   Int
  name        String
  description String?
  roomType    RoomType
  maxGuests   Int
  bedrooms    Int?
  beds        Int
  bathrooms   Int
  basePrice   Decimal       @db.Decimal(10, 2)
  // for V1 only considering one room of each type
  // no iventory control is there
  quantity    Int           @default(1)
  area        Float?
  areaUnit    AreaUnit?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  bookings    Booking[]
  listing     Listing       @relation(fields: [listingId], references: [listingId], onDelete: Cascade)
  amenities   RoomAmenity[]
  images      RoomImage[]

  @@index([listingId])
  @@index([roomType])
  @@index([isActive])
}

model Amenity {
  amenityId Int              @id @default(autoincrement())
  name      String           @unique
  rooms     RoomAmenity[]
  listings  ListingAmenity[]
}

model RoomAmenity {
  roomId    Int
  amenityId Int
  amenity   Amenity @relation(fields: [amenityId], references: [amenityId], onDelete: Cascade)
  room      Room    @relation(fields: [roomId], references: [roomId], onDelete: Cascade)

  @@id([roomId, amenityId])
}

model ListingAmenity {
  listingId  Int
  amenityId Int
  amenity    Amenity @relation(fields: [amenityId], references: [amenityId], onDelete: Cascade)
  listing    Listing @relation(fields: [listingId], references: [listingId], onDelete: Cascade)

  @@id([listingId, amenityId])
}

model RoomImage {
  imageId      Int      @id @default(autoincrement())
  roomId       Int
  altText      String?
  imageUrl     String
  publicId     String
  isCover      Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  room         Room     @relation(fields: [roomId], references: [roomId])
}

model Review {
  reviewId  Int      @id @default(autoincrement())
  bookingId Int      @unique
  listingId Int
  guestId   Int
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  booking   Booking  @relation(fields: [bookingId], references: [bookingId], onDelete: Cascade)
  guest     User     @relation(fields: [guestId], references: [userId], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [listingId], onDelete: Cascade)

  @@index([listingId])
  @@index([guestId])
}

model Wishlist {
  userId    Int
  listingId Int

  user    User    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [listingId], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, listingId])
  @@index([userId, createdAt])
  @@index([listingId])
}

model HostRequest {
  requestId        Int               @id @default(autoincrement())
  userId           Int
  phoneNumber      String
  governmentIdType GovernmentIdType
  governmentIdUrl  String
  businessName     String?
  status           HostRequestStatus @default(PENDING)
  verifiedById     Int?
  adminNotes       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  verifiedAt       DateTime?
  user             User              @relation(fields: [userId], references: [userId], onDelete: Cascade)
  verifiedBy       User?             @relation("HostRequestVerifier", fields: [verifiedById], references: [userId])

  @@index([userId, status])
  @@index([status])
}

model Listing {
  listingId    Int         @id @default(autoincrement())
  ownerId      Int
  type         ListingType
  name         String
  description  String
  checkInTime  DateTime?   @db.Time
  checkOutTime DateTime?   @db.Time
  contactPhone String
  contactEmail String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  country      String
  postalCode   String
  latitude     Float?
  longitude    Float?
  thumbnailUrl String?

  status       ListingStatus @default(DRAFT)
  adminNotes   String?
  reviewedAt   DateTime?
  approvedById Int?

  bookingMode   BookingMode
  isActive      Boolean          @default(true) // it means if the room is ready for booking
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  publishedAt   DateTime?
  averageRating Decimal?         @db.Decimal(2, 1)
  landmark      String?
  reviewCount   Int              @default(0)
  bookings      Booking[]
  approvedBy    User?            @relation("ListingApprover", fields: [approvedById], references: [userId])
  owner         User             @relation("ListingOwner", fields: [ownerId], references: [userId], onDelete: Cascade)
  images        ListingImage[]
  reviews       Review[]
  rooms         Room[]
  wistlist      Wishlist[]
  amenities     ListingAmenity[]

  @@index([city, type, status])
  @@index([ownerId])
  @@index([type])
  @@index([status])
  @@index([city])
  @@index([country])
}

model ListingImage {
  imageId      Int      @id @default(autoincrement())
  listingId    Int
  imageUrl     String
  publicId     String
  caption      String?
  isThumbnail  Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  listing      Listing  @relation(fields: [listingId], references: [listingId], onDelete: Cascade)

  @@index([listingId])
}

enum BookingStatus {
  AWAITING_PAYMENT
  CONFIRMED
  CANCELLED
  CHECKED_IN
  CHECKED_OUT
  COMPLETED
}

enum BookingPayment {
  PENDING
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum PaymentOption {
  PAY_NOW
  BOOK_ONLY
}

enum PaymentMode {
  CASH
  ONLINE
}

enum PaymentPurpose {
  BOOKING
  REMAINING
  REFUND
  PENALTY
}

enum PaymentGateway {
  RAZORPAY
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum RoomType {
  SINGLE
  DOUBLE
  TWIN
  TRIPLE
  QUAD
  DORMITORY
  SUITE
  DELUXE
  FAMILY
  STUDIO
  ENTIRE_UNIT
}

enum AreaUnit {
  SQ_FT
  SQ_M
}

enum HostRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GovernmentIdType {
  AADHAAR
  PASSPORT
  DRIVING_LICENSE
  VOTER_ID
  PAN
  OTHER
}

enum ListingType {
  HOTEL
  PG
  HOSTEL
  APARTMENT
  VILLA
  HOMESTAY
  RESORT
}

enum ListingStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum BookingMode {
  ENTIRE_PROPERTY
  PER_ROOM
}
